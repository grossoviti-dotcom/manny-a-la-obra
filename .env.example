# Postgres (Neon). Usá la URL "pooled" del proyecto.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secreto para firmar las sesiones (mín. 32 caracteres). Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# Sólo para el seed: credenciales de la cuenta admin de demostración.
SEED_ADMIN_EMAIL="admin@manny.example"
SEED_ADMIN_PASSWORD=""

# URL pública del sitio (metadatos, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
